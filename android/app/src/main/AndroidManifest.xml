<?xml version="1.0" encoding="utf-8"?>
<!-- Версия: 3.5 (11.11) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Шаг 4: приём файлов из «Поделиться» (intent-filter ниже) и FileProvider для отправки файлов.
         Шаг 5 (этот APK): уведомления при закрытом приложении — POST_NOTIFICATIONS (запрос на Android 13+),
         точные будильники напоминаний (USE_EXACT_ALARM на Android 13+ выдаётся автоматически, SCHEDULE_EXACT_ALARM
         только для Android 12 и ниже), RECEIVE_BOOT_COMPLETED (будильники и опрос ставятся заново после перезагрузки).
         Для сохранения в «Загрузки» разрешений не нужно (MediaStore). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Создание ярлыков на рабочем столе (кнопка «Создать ярлык сканера QR-кодов» в настройках; до Android 8 — этим разрешением,
         на новых версиях запрос подтверждает пользователь в окне рабочего стола). У Xiaomi есть ещё своё разрешение «Ярлыки на
         рабочем столе» в настройках приложения — его выдаёт пользователь (кнопка «Открыть разрешения приложения»). -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16: «живые обновления» (продвигаемые постоянные уведомления; у Xiaomi HyperOS 3 — динамический остров) для таймеров карточек. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Будильники карточек (CardAlarms): на несколько секунд подсветить экран, когда звонит будильник на заблокированном телефоне. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 5-9 (minSdk 21): сохранение в «Загрузки» без MediaStore; на Android 10+ разрешение не нужно и не запрашивается. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- Доступ ко всем файлам (AllFilesAccess): удаление треков во вкладке «Музыка», дальше — файловый менеджер.
         Android 11+ — MANAGE_EXTERNAL_STORAGE (выдаётся на экране настроек «Доступ ко всем файлам»), Android 6–10 — чтение и запись
         общего хранилища (requestLegacyExternalStorage ниже — для Android 10). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Заготовка под будущее (ТЗ, раздел 5; без реализации): foreground service для секундомера/таймера/записи с уведомлением
         в шторке. Начиная с Android 14 у такого сервиса обязателен тип; для таймера и секундомера подходит "specialUse".
         Когда понадобится: объявить <service android:name=".TimerService" android:foregroundServiceType="specialUse" ...>
         со свойством PROPERTY_SPECIAL_USE_FGS_SUBTYPE и запускать его из страницы через мост. -->
    <!-- Вкладка «Система»: усиление громкости (LoudnessEnhancer на общей аудиосессии). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Плеер вкладки «Музыка» (MusicService): служба переднего плана типа mediaPlayback. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Вкладка «Тренировки» (WorkoutService): запись маршрута по GPS при погашенном экране. ACCESS_FINE_LOCATION запрашивается
         по нажатию «Запись»; фоновое разрешение (ACCESS_BACKGROUND_LOCATION) не нужно — служба стартует из открытого приложения. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher_app"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeTracker"
        android:usesCleartextTraffic="false">

        <!-- screenOrientation намеренно НЕ задан: поворот работает при включённом автоповороте.
             configChanges: при повороте и смене размера Activity не пересоздаётся, страница не перезагружается. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale|layoutDirection|locale|navigation|colorMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Шаг 4: «Поделиться → LifeTracker» (замена Web Share Target из manifest.json).
                 Типы те же, что принимала PWA: видео, epub, fb2 (часть файловых менеджеров отдаёт fb2 как
                 octet-stream или xml). Что делать с файлом, решает страница по расширению (handleSharedFile в my.js).
                 Текст и ссылки пока не принимаются: в PWA такой функции не было (вопрос заказчику, 12.9). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/x-fictionbook" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/xml" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/x-fictionbook" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/xml" />
            </intent-filter>
            <!-- «Открыть с помощью» для PDF и epub из файлового менеджера: файл читается в ридере без добавления в библиотеку
                 (SharedInbox.accept принимает ACTION_VIEW, страница — handleSharedFile(file, true)). Фильтры разведены по случаям:
                 1) тип известен (content:// из провайдера; файловые менеджеры пишут и нестандартные типы pdf/epub);
                 2) тип «любой» или octet-stream, но в адресе есть расширение;
                 3) тип не задан вовсе (file:// без типа), решает только расширение. Расширения — и строчные, и заглавные
                 (pathPattern различает регистр). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/x-pdf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/epub" />
                <data android:mimeType="application/x-epub+zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.epub" />
                <data android:pathPattern=".*\\..*\\.epub" />
                <data android:pathPattern=".*\\..*\\..*\\.epub" />
                <data android:pathPattern=".*\\.EPUB" />
                <data android:pathPattern=".*\\.pdf" />
                <data android:pathPattern=".*\\..*\\.pdf" />
                <data android:pathPattern=".*\\..*\\..*\\.pdf" />
                <data android:pathPattern=".*\\.PDF" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.epub" />
                <data android:pathPattern=".*\\..*\\.epub" />
                <data android:pathPattern=".*\\..*\\..*\\.epub" />
                <data android:pathPattern=".*\\.EPUB" />
                <data android:pathPattern=".*\\.pdf" />
                <data android:pathPattern=".*\\..*\\.pdf" />
                <data android:pathPattern=".*\\..*\\..*\\.pdf" />
                <data android:pathPattern=".*\\.PDF" />
            </intent-filter>
            <!-- 4) Проводники, которые отдают pdf/epub как octet-stream или zip без расширения в адресе (content://…/document/123).
                 Приложение попадает в «Открыть с помощью» и для других файлов этих типов; страница такие файлы молча пропускает
                 (handleSharedFile открывает только pdf и epub). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="binary/octet-stream" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Ярлык «Создать новую задачу» (долгое нажатие на иконку, res/xml/shortcuts.xml): маленькое окно над клавиатурой
             БЕЗ запуска основного приложения. Свой task (taskAffinity пустой) и прозрачная тема — основное окно приложения
             не поднимается, под окном остаётся рабочий стол. Задача складывается в очередь QuickTaskStore, страница
             забирает её при следующем открытии приложения и кладёт в Inbox. -->
        <activity
            android:name=".QuickTaskActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale|layoutDirection|locale|navigation|colorMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/shortcut_new_task"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/QuickTaskTheme"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- Ярлык «Сканировать QR-код» (карточки предметов): окно сканера на весь экран и показ карточки на фоне рабочего
             стола, БЕЗ запуска основного приложения (свой task, прозрачная тема ScanTheme, как у QuickTaskActivity).
             Карточка-заметка по нажатию открывает MainActivity (ACTION_OPEN_CARD). -->
        <activity
            android:name=".ScanActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale|layoutDirection|locale|navigation|colorMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/shortcut_scan_qr"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/ScanTheme" />

        <!-- Ярлык «Секундомер» (долгое нажатие на иконку, res/xml/shortcuts.xml): без окна — запускает секундомер и службу с островом,
             основное приложение не открывается (свой task, прозрачная тема, как у ScanActivity). -->
        <activity
            android:name=".StopwatchActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/shortcut_stopwatch"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/ScanTheme" />

        <!-- Секундомер: уведомление с кнопками и остров Xiaomi, раз в секунду обновляется, пока секундомер идёт. -->
        <service
            android:name=".StopwatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="stopwatch_island_clock" />
        </service>

        <!-- Шаг 4: временные файлы для «Поделиться» (cache/share/, см. res/xml/file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.app.lifetracker.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Шаг 5: будильник напоминаний, опрос общих задач, кнопки уведомлений, перезагрузка и смена времени.
             exported="false": принимает только свои PendingIntent и системные рассылки. -->
        <receiver
            android:name=".NotifyReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Таймеры карточек (CardTimers): будильник окончания и кнопки уведомления «Пауза / Продолжить / Отмена». -->
        <receiver
            android:name=".CardTimerReceiver"
            android:exported="false" />

        <!-- Будильники карточек (CardAlarms): звонок и повторы. -->
        <receiver
            android:name=".CardAlarmReceiver"
            android:exported="false" />

        <!-- Тик острова Xiaomi для таймеров карточек (раз в секунду обновляет время); работает, только пока идёт таймер. -->
        <service
            android:name=".TimerTickService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="card_timer_island_countdown" />
        </service>

        <!-- Плеер вкладки «Музыка»: уведомление с кнопками и остров Xiaomi, пока играет музыка (в том числе при погашенном экране). -->
        <service
            android:name=".MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Видео и звук вкладки-сайта в фоне (SiteMediaService): уведомление «Пауза/Закрыть» и остров Xiaomi, пока ролик играет при свёрнутом приложении. -->
        <service
            android:name=".SiteMediaService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Вкладка «Тренировки»: запись тренировки по GPS, уведомление с кнопками и остров Xiaomi, пока идёт запись. -->
        <service
            android:name=".WorkoutService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Помодоро: будильник конца фазы. -->
        <receiver
            android:name=".PomodoroReceiver"
            android:exported="false" />

        <!-- Вкладка «Помодоро»: уведомление с кнопками и остров Xiaomi, раз в секунду обновляется, пока идёт сессия. -->
        <service
            android:name=".PomodoroService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="pomodoro_island_countdown" />
        </service>

        <!-- Вкладка «Система»: держит усиление громкости, пока оно выше 100 %, и проверяет, что система его не сбросила. -->
        <service
            android:name=".VolumeBoostService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="volume_boost_audio_effect" />
        </service>

        <!-- Виджет рабочего стола «Стопка QR-карточек» 2×2 (вкладка «Конструктор виджетов»): QrWidgets.kt. -->
        <receiver
            android:name=".QrWidgetProvider"
            android:exported="true"
            android:label="Стопка QR-карточек">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/qr_widget_info" />
        </receiver>

        <service
            android:name=".QrWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <activity
            android:name=".QrWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/ScanTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
