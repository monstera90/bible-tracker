<?xml version="1.0" encoding="utf-8"?>
<!-- Версия: 3.0 (12.11)
     Виджет «Стопка QR-карточек» 2×2. Картинка карточки — прямоугольник высотой 1,06 ширины (QrWidgets.FACE_ASPECT) и заполняет весь слот
     лаунчера. StackView рисует «стопку» сам, и его передняя карточка (замер на Poco, в долях размера StackView): по ширине ≈0,877, по
     высоте ≈0,833, с внутренним отступом от левого нижнего угла ≈2,2 % ширины и ≈1,8 % высоты; остальные карточки выглядывают сверху
     справа. Поэтому StackView больше слота и сдвинут так, чтобы левый и нижний края передней карточки совпали с краями слота, а верхний
     и правый вышли за слот на 2–4 % (задних карточек не видно ни по краям, ни сквозь прозрачные углы передней). Всё — только весами
     (weightSum), поэтому сдвиг пропорционален размеру слота и от dp не зависит; scale/translation не используются. Цепочка вложенных
     LinearLayout: qr_h1 (gravity right, weightSum 0,975) → qr_v1 (gravity top, weightSum 0,977) → qr_h2 (weightSum 0,87) → qr_v2
     (gravity bottom, weightSum 0,82) → StackView. Внешняя пара (0,975 / 0,977) шире и выше слота ровно настолько, чтобы внутренний
     отступ StackView ушёл за левый и нижний края (0,975 = 1 − 0,0217/0,87; 0,977 = 1 − 0,0183/0,82); внутренняя пара (0,87 / 0,82) задаёт
     выход карточки за верх и правый край. Подгонка по скриншоту — менять только эти числа. Все LinearLayout режут по своим границам,
     они совпадают с границами слота, поэтому лишнее уходит за слот. qr_clip режет всё по скруглённому контуру (clipToOutline; фон
     qr_widget_clip_<dp> — прозрачный, нужен только ради контура; радиус ≈ 12 % ширины карточки, подставляет QrWidgets.applyHostLayout).
     qr_root — отступы на случай, если лаунчер отдал явно другую пропорцию. layoutDirection ltr — иначе при письме справа налево
     стопка уедет. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/qr_clip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/qr_widget_clip_22"
        android:clipChildren="true"
        android:clipToOutline="true"
        android:layoutDirection="ltr">

        <LinearLayout
            android:id="@+id/qr_h1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="true"
            android:gravity="right"
            android:orientation="horizontal"
            android:weightSum="0.975">

            <LinearLayout
                android:id="@+id/qr_v1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="true"
                android:gravity="top"
                android:orientation="vertical"
                android:weightSum="0.977">

                <LinearLayout
                    android:id="@+id/qr_h2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipChildren="true"
                    android:orientation="horizontal"
                    android:weightSum="0.87">

                    <LinearLayout
                        android:id="@+id/qr_v2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clipChildren="true"
                        android:gravity="bottom"
                        android:orientation="vertical"
                        android:weightSum="0.82">

                        <StackView
                            android:id="@+id/qr_stack"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:loopViews="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/qr_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/qr_widget_empty_bg"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </FrameLayout>
</FrameLayout>
