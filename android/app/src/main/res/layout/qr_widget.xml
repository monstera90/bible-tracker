<?xml version="1.0" encoding="utf-8"?>
<!--  Версия: 2.2 (12.11)
     Виджет «Стопка QR-карточек» 2×2. Картинка карточки — прямоугольник высотой 1,06 ширины (QrWidgets.FACE_ASPECT). StackView рисует
     «стопку» сам: передняя карточка получается меньше 0,9 его размера (замер на Poco: по ширине ≈0,877, по высоте ≈0,833), в левом
     нижнем углу, остальные выглядывают сверху справа. Поэтому StackView делается больше области (у единственного ребёнка вес 1 при
     weightSum: qr_h 0,86 — по ширине, qr_v 0,80 — по высоте) и прижимается к левому нижнему углу (gravity bottom у qr_v, у qr_h ребёнок
     идёт слева): передняя карточка на 2–4 % БОЛЬШЕ области — выходит за верхний и правый края, и задние карточки не видны ни по
     краям, ни сквозь прозрачные углы передней. Без масштабирования. qr_clip режет всё по скруглённому контуру (clipToOutline; фон
     qr_widget_clip_<dp> — прозрачный, нужен только ради контура; радиус ≈ 12 % ширины карточки, подставляет QrWidgets.applyHostLayout),
     нижняя окантовка остаётся видна целиком. qr_root — отступы на случай, если лаунчер отдал явно другую пропорцию. layoutDirection
     ltr — иначе при письме справа налево стопка уедет. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/qr_clip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/qr_widget_clip_22"
        android:clipChildren="true"
        android:clipToOutline="true"
        android:layoutDirection="ltr">

        <LinearLayout
            android:id="@+id/qr_h"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="true"
            android:orientation="horizontal"
            android:weightSum="0.86">

            <LinearLayout
                android:id="@+id/qr_v"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="true"
                android:gravity="bottom"
                android:orientation="vertical"
                android:weightSum="0.80">

                <StackView
                    android:id="@+id/qr_stack"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:loopViews="true" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/qr_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/qr_widget_empty_bg"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/qr_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="5dp"
            android:layout_marginRight="5dp"
            android:contentDescription="@null"
            android:scaleType="center"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
