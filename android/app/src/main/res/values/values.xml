<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Life tracker</string>
    <string name="shortcut_diag">Диагностика</string>

    <!-- Фон окна и полос системных панелей до того, как страница сообщит свои цвета (background_color из manifest.json). -->
    <color name="window_bg">#F4F0F8</color>
    <!-- Фон адаптивной иконки (кольцо вокруг картинки). Подберите под свою иконку, см. README_ANDROID.md. -->
    <color name="ic_launcher_background">#8F7FB8</color>

    <style name="Theme.LifeTracker" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <!-- Не затемнять страницу принудительно: у приложения свои темы. -->
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
