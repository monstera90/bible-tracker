<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8.0+: адаптивная иконка (та же, что была в ic_launcher.xml). До Android 8.0 берутся обычные PNG
     из mipmap-mdpi … mipmap-xxxhdpi (ic_launcher_app.png): на Android 5.0 лаунчер не умел читать прежнюю иконку-XML
     (layer-list с процентным отступом) и показывал значок-заглушку. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
