<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Файлы, подготовленные для системного меню «Поделиться» (FileSaver.beginStage). Только эта папка. -->
    <cache-path name="share" path="share/" />
    <!-- Скачанный APK новой сборки для установщика (ApkUpdater): files/apkupdate/. -->
    <files-path name="apk_update" path="apkupdate/" />
    <!-- Скачанные файлы в «Загрузках» и папках пользователя: кнопка «Открыть» в острове (DownloadTarget.viewIntent). -->
    <external-path name="downloaded" path="." />
</paths>
