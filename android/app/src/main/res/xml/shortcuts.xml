<?xml version="1.0" encoding="utf-8"?>
<!-- Версия: 1.1 (14.10) — у обоих пунктов свой значок (`android:icon`): ic_shortcut_diag, ic_shortcut_new_task. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Долгое нажатие на иконку приложения → «Диагностика»: проверка хранилища, OPFS, камеры и сетевых сервисов. -->
    <shortcut
        android:enabled="true"
        android:shortcutId="diag"
        android:icon="@drawable/ic_shortcut_diag"
        android:shortcutShortLabel="@string/shortcut_diag">
        <intent
            android:action="com.app.lifetracker.DIAG"
            android:targetClass="com.app.lifetracker.MainActivity"
            android:targetPackage="com.app.lifetracker" />
    </shortcut>
    <!-- Там же, сразу под «Диагностикой»: «Создать новую задачу» — окно над клавиатурой, основное приложение не открывается
         (QuickTaskActivity). Порядок в меню задаёт лаунчер: пункты идут в порядке объявления в этом файле. -->
    <shortcut
        android:enabled="true"
        android:shortcutId="new_task"
        android:icon="@drawable/ic_shortcut_new_task"
        android:shortcutShortLabel="@string/shortcut_new_task"
        android:shortcutLongLabel="@string/shortcut_new_task">
        <intent
            android:action="com.app.lifetracker.NEW_TASK"
            android:targetClass="com.app.lifetracker.QuickTaskActivity"
            android:targetPackage="com.app.lifetracker" />
    </shortcut>
</shortcuts>
