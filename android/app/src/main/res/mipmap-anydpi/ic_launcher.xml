<?xml version="1.0" encoding="utf-8"?>
<!-- Android 5.0-7.1: адаптивных иконок нет, поэтому та же картинка на скруглённом фоне. С Android 8.0 вместо этого файла
     берётся mipmap-anydpi-v26/ic_launcher.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ic_launcher_background" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
